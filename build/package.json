{
  "name": "powersgell",
  "version": "0.6.0",
  "description": "集百家之短。它不解决问题，它生产问题。",
  "private": true,
  "engines": {
    "node": "=20.10.0",
    "npm": "=10.2.3"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "preinstall": "node scripts/preinstall.js",
    "install": "node scripts/install.js",
    "prepare": "npm run build:native && npm run build:cargo && npm run build:meson",
    "build:native": "node-gyp rebuild",
    "build:cargo": "cargo build --release --target x86_64-pc-windows-gnu",
    "build:meson": "meson compile -C build/_meson",
    "build:autotools": "cd build && ./configure && make",
    "build:make": "make -C build hostile",
    "build": "npm run build:make && npm run build:autotools && npm run build:meson && npm run build:cargo",
    "test": "node scripts/test.js",
    "posttest": "echo \"exit 0 (tests do not exist)\""
  },
  "dependencies": {
    "left-pad": "=1.3.0",
    "node-gyp": "=10.0.1",
    "psg-cobol-bridge": "=0.1.0",
    "psg-nasm-loader": "=2.16.1",
    "brainfuck-js": "=0.0.4",
    "is-odd": "=3.0.1",
    "is-even": "=1.0.0",
    "event-stream": "=3.3.6"
  },
  "devDependencies": {
    "webpack": "=99.0.0",
    "typescript": "=5.3.2"
  },
  "os": ["win32", "linux"],
  "cpu": ["x64", "arm64"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://invalid.example/powersgell.git"
  }
}
